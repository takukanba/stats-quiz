<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>心理学統計法 クイズ</title>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
  font-family: 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
  background: #f0f4f3;
  color: #333;
  min-height: 100vh;
}

header {
  background: #4F7F8F;
  color: white;
  padding: 16px 20px;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
header h1 { font-size: 15px; font-weight: bold; margin-bottom: 8px; }
.header-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
.header-score { font-size: 12px; background: rgba(255,255,255,0.2); padding: 4px 10px; border-radius: 20px; }
.progress-bar-wrap { background: rgba(255,255,255,0.25); border-radius: 4px; height: 5px; }
.progress-bar { background: #E8A164; height: 5px; border-radius: 4px; transition: width 0.4s ease; }
.progress-text { font-size: 11px; margin-top: 4px; opacity: 0.85; }

.main { max-width: 680px; margin: 0 auto; padding: 16px 14px 100px; }

.card {
  background: white;
  border-radius: 16px;
  padding: 22px 18px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.07);
  margin-bottom: 14px;
}

/* Tab bar */
.tab-bar {
  display: flex;
  background: white;
  border-radius: 12px;
  padding: 4px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.07);
  margin-bottom: 14px;
  gap: 4px;
}
.tab-btn {
  flex: 1;
  padding: 10px 6px;
  border: none;
  background: transparent;
  border-radius: 8px;
  font-size: 13px;
  font-weight: bold;
  color: #888;
  cursor: pointer;
  transition: all 0.2s;
}
.tab-btn.active { background: #4F7F8F; color: white; }

/* Question */
.q-number { font-size: 12px; color: #4F7F8F; font-weight: bold; margin-bottom: 8px; }
.q-badge {
  display: inline-block;
  font-size: 10px;
  padding: 2px 8px;
  border-radius: 10px;
  margin-left: 8px;
  font-weight: normal;
}
.badge-preset { background: #E7EEEC; color: #4F7F8F; }
.badge-ai { background: #fff3e6; color: #E8A164; }
.q-text { font-size: 16px; font-weight: bold; line-height: 1.6; margin-bottom: 18px; color: #222; }
.choices { display: flex; flex-direction: column; gap: 10px; }
.choice-btn {
  background: #E7EEEC;
  border: 2px solid transparent;
  border-radius: 12px;
  padding: 13px 15px;
  text-align: left;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.18s;
  color: #333;
  line-height: 1.4;
}
.choice-btn:hover:not(:disabled) { background: #d4e4e0; border-color: #4F7F8F; transform: translateY(-1px); }
.choice-btn.correct { background: #d4edda; border-color: #28a745; color: #155724; font-weight: bold; }
.choice-btn.wrong { background: #f8d7da; border-color: #dc3545; color: #721c24; }
.choice-btn.reveal-correct { background: #d4edda; border-color: #28a745; color: #155724; opacity: 0.7; }
.choice-btn:disabled { cursor: default; }

.explain-box {
  display: none;
  margin-top: 14px;
  padding: 13px 15px;
  background: #f8f9fa;
  border-left: 4px solid #4F7F8F;
  border-radius: 0 8px 8px 0;
  font-size: 14px;
  line-height: 1.7;
  color: #444;
}
.explain-box.show { display: block; animation: fadeIn 0.3s ease; }
.explain-label { font-weight: bold; color: #4F7F8F; display: block; margin-bottom: 5px; font-size: 12px; }

.next-btn {
  display: none;
  margin-top: 16px;
  width: 100%;
  background: #4F7F8F;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 14px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.2s;
}
.next-btn:hover { background: #3d6470; }
.next-btn.show { display: block; animation: fadeIn 0.3s ease; }

/* AI Generate panel */
.ai-panel .section-title {
  font-size: 14px;
  font-weight: bold;
  color: #4F7F8F;
  margin-bottom: 12px;
}
.topic-input {
  width: 100%;
  border: 2px solid #E7EEEC;
  border-radius: 10px;
  padding: 12px 14px;
  font-size: 14px;
  outline: none;
  transition: border 0.2s;
  resize: none;
  font-family: inherit;
}
.topic-input:focus { border-color: #4F7F8F; }
.count-row { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.count-chip {
  padding: 6px 14px;
  border: 2px solid #E7EEEC;
  border-radius: 20px;
  font-size: 13px;
  cursor: pointer;
  background: white;
  transition: all 0.2s;
  color: #555;
}
.count-chip.selected { background: #4F7F8F; border-color: #4F7F8F; color: white; font-weight: bold; }
.generate-btn {
  margin-top: 14px;
  width: 100%;
  background: #E8A164;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 14px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.2s;
}
.generate-btn:hover:not(:disabled) { background: #d08a4e; }
.generate-btn:disabled { background: #ccc; cursor: not-allowed; }
.generate-btn.loading { opacity: 0.8; }

.loading-msg {
  display: none;
  text-align: center;
  padding: 24px;
  color: #4F7F8F;
  font-size: 14px;
}
.loading-msg.show { display: block; animation: fadeIn 0.3s; }
.spinner {
  width: 36px; height: 36px;
  border: 3px solid #E7EEEC;
  border-top-color: #4F7F8F;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 12px;
}

.ai-queue-card {
  background: #fff8f2;
  border: 2px solid #E8A164;
  border-radius: 12px;
  padding: 14px 16px;
  margin-top: 12px;
  font-size: 13px;
  color: #555;
  line-height: 1.6;
}
.ai-queue-title { font-weight: bold; color: #E8A164; margin-bottom: 6px; font-size: 14px; }
.ai-queue-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 0;
  border-bottom: 1px solid #f0e8dc;
}
.ai-queue-item:last-child { border-bottom: none; }
.ai-queue-delete {
  background: none;
  border: none;
  color: #dc3545;
  cursor: pointer;
  font-size: 16px;
  padding: 0 4px;
  line-height: 1;
}

.preset-list { display: flex; flex-direction: column; gap: 8px; }
.preset-item {
  display: flex;
  align-items: center;
  padding: 10px 12px;
  border: 2px solid #E7EEEC;
  border-radius: 10px;
  font-size: 13px;
  color: #444;
  cursor: pointer;
  transition: all 0.18s;
  background: white;
  text-align: left;
}
.preset-item:hover { border-color: #E8A164; background: #fff8f2; }
.preset-num { color: #4F7F8F; font-weight: bold; margin-right: 10px; min-width: 28px; }

/* Result */
.result-screen { display: none; text-align: center; padding: 32px 16px; }
.result-screen.show { display: block; }
.result-score { font-size: 56px; font-weight: bold; color: #4F7F8F; }
.result-total { font-size: 18px; color: #666; margin-top: 6px; }
.result-msg { font-size: 17px; font-weight: bold; margin-top: 18px; color: #333; }
.result-sub { font-size: 13px; color: #777; margin-top: 8px; line-height: 1.7; }
.score-bar { margin-top: 20px; background: #E7EEEC; border-radius: 8px; height: 16px; overflow: hidden; }
.score-bar-fill { background: linear-gradient(90deg, #4F7F8F, #E8A164); height: 100%; border-radius: 8px; transition: width 1s ease; }
.restart-btn {
  margin-top: 24px;
  background: #E8A164;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 14px 36px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.2s;
}
.restart-btn:hover { background: #d08a4e; }

/* Start */
.start-screen { text-align: center; padding: 32px 16px; }
.start-screen h2 { font-size: 20px; color: #4F7F8F; margin-bottom: 10px; }
.start-screen p { font-size: 14px; color: #666; line-height: 1.8; margin-bottom: 24px; }
.start-btn {
  background: #4F7F8F;
  color: white;
  border: none;
  border-radius: 12px;
  padding: 14px 44px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
  transition: background 0.2s;
}
.start-btn:hover { background: #3d6470; }

.error-msg { color: #dc3545; font-size: 13px; margin-top: 10px; display: none; }
.error-msg.show { display: block; }

.section-divider { height: 1px; background: #E7EEEC; margin: 16px 0; }
.total-count { font-size: 12px; color: #888; margin-top: 8px; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>

<header>
  <div class="header-row">
    <h1>心理学統計法　クイズ</h1>
    <div class="header-score" id="headerScore">0 / 0</div>
  </div>
  <div class="progress-bar-wrap">
    <div class="progress-bar" id="progressBar" style="width:0%"></div>
  </div>
  <div class="progress-text" id="progressText">0 / 0 問</div>
</header>

<div class="main">

  <!-- Tab bar -->
  <div class="tab-bar">
    <button class="tab-btn active" id="tab-quiz" onclick="switchTab('quiz')">📝 クイズ</button>
    <button class="tab-btn" id="tab-ai" onclick="switchTab('ai')">🤖 AI問題追加</button>
  </div>

  <!-- ===== QUIZ TAB ===== -->
  <div id="tabQuiz">

    <!-- Start screen -->
    <div class="card start-screen" id="startScreen">
      <h2>試験対策クイズ</h2>
      <p id="startDesc">全50問・4択形式<br>選択肢をタップすると正誤がわかります<br>解説を読んで次の問題へ進みましょう</p>
      <button class="start-btn" onclick="startQuiz()">スタート →</button>
    </div>

    <!-- Question -->
    <div id="quizArea" style="display:none">
      <div class="card">
        <div class="q-number" id="qNumber">問題 1</div>
        <div class="q-text" id="qText"></div>
        <div class="choices" id="choices"></div>
        <div class="explain-box" id="explainBox">
          <span class="explain-label">📖 解説</span>
          <span id="explainText"></span>
        </div>
        <button class="next-btn" id="nextBtn" onclick="nextQuestion()">次の問題 →</button>
      </div>
    </div>

    <!-- Result -->
    <div class="card result-screen" id="resultScreen">
      <div style="font-size:44px;margin-bottom:10px">🎉</div>
      <div class="result-score" id="resultScore">0</div>
      <div class="result-total" id="resultTotal">/ 50 問正解</div>
      <div class="score-bar"><div class="score-bar-fill" id="scoreBarFill" style="width:0%"></div></div>
      <div class="result-msg" id="resultMsg"></div>
      <div class="result-sub" id="resultSub"></div>
      <button class="restart-btn" onclick="restartQuiz()">もう一度挑戦する</button>
    </div>

  </div>

  <!-- ===== AI TAB ===== -->
  <div id="tabAi" style="display:none">

    <div class="card ai-panel">
      <div class="section-title">🤖 AIで問題を自動生成</div>
      <p style="font-size:13px;color:#666;margin-bottom:14px;line-height:1.6">テーマを入力するとAIが心理学統計の問題を作成します。生成した問題はクイズに追加されます。</p>

      <textarea class="topic-input" id="topicInput" rows="3"
        placeholder="例：t検定の使い方&#10;例：尺度水準の違い&#10;例：信頼性と妥当性の区別"></textarea>

      <div style="font-size:12px;color:#888;margin-top:10px;margin-bottom:6px">生成する問題数：</div>
      <div class="count-row" id="countRow">
        <button class="count-chip selected" onclick="selectCount(this, 3)">3問</button>
        <button class="count-chip" onclick="selectCount(this, 5)">5問</button>
        <button class="count-chip" onclick="selectCount(this, 10)">10問</button>
      </div>

      <button class="generate-btn" id="generateBtn" onclick="generateQuestions()">✨ 問題を生成する</button>
      <div class="error-msg" id="errorMsg">問題の生成に失敗しました。もう一度お試しください。</div>
    </div>

    <!-- Loading -->
    <div class="card loading-msg" id="loadingMsg">
      <div class="spinner"></div>
      AIが問題を考えています…<br>
      <span style="font-size:12px;color:#aaa;margin-top:4px;display:block">10〜20秒ほどかかります</span>
    </div>

    <!-- AI Queue -->
    <div id="aiQueueArea" style="display:none">
      <div class="ai-queue-card">
        <div class="ai-queue-title">✅ 追加済みAI問題 <span id="aiQueueCount"></span></div>
        <div id="aiQueueList"></div>
      </div>
    </div>

    <div class="section-divider"></div>

    <!-- Preset topics -->
    <div class="card">
      <div class="section-title" style="margin-bottom:10px">💡 よく使われるテーマ例</div>
      <div class="preset-list">
        <button class="preset-item" onclick="setTopic('p値と有意水準の意味')"><span class="preset-num">01</span>p値と有意水準の意味</button>
        <button class="preset-item" onclick="setTopic('4つの尺度水準（名義・順序・間隔・比率）')"><span class="preset-num">02</span>4つの尺度水準の違い</button>
        <button class="preset-item" onclick="setTopic('t検定とANOVAの使い分け')"><span class="preset-num">03</span>t検定とANOVAの使い分け</button>
        <button class="preset-item" onclick="setTopic('相関係数の解釈と因果の違い')"><span class="preset-num">04</span>相関係数と因果関係</button>
        <button class="preset-item" onclick="setTopic('第1種誤りと第2種誤りの違い')"><span class="preset-num">05</span>第1種・第2種誤り</button>
        <button class="preset-item" onclick="setTopic('効果量（Cohenのd）の解釈')"><span class="preset-num">06</span>効果量の解釈</button>
        <button class="preset-item" onclick="setTopic('信頼性と妥当性の違い')"><span class="preset-num">07</span>信頼性と妥当性</button>
        <button class="preset-item" onclick="setTopic('回帰分析の基礎')"><span class="preset-num">08</span>回帰分析の基礎</button>
      </div>
    </div>

  </div>

</div>

<script>
// ============================================================
// DATA: preset 50 questions
// ============================================================
const presetQuestions = [
  {q:"心理学で統計学を用いる最も重要な理由は何か。",choices:["A. 数学の練習をするため","B. 心理学を難しくするため","C. 偶然と本当の効果を区別するため","D. コンピュータを使うため"],answer:2,explain:"統計は「偶然か、本当の介入効果か」を区別するために使います。ABAでも、PFA導入後に問題行動が減った場合、偶然ではなく介入効果であると示すために統計が必要です。",type:"preset"},
  {q:"心理学でいう「変数」とは何か。",choices:["A. 人","B. 変化する値","C. 実験室","D. 教科書"],answer:1,explain:"変数とは変化するものです。身長・IQ・幸福度・年齢・点数など、値が変わるものはすべて変数です。",type:"preset"},
  {q:"名義尺度はどれか。",choices:["A. 身長","B. 温度","C. 性別","D. IQ"],answer:2,explain:"名義尺度はただ分類するだけで順番がありません。血液型・性別・好きな動物などが例です。",type:"preset"},
  {q:"順序尺度はどれか。",choices:["A. 身長","B. マラソン順位","C. 温度","D. IQ"],answer:1,explain:"順位は1位・2位・3位という順番はありますが、1位と2位の差と2位と3位の差は同じではありません。これが順序尺度です。",type:"preset"},
  {q:"平均値が最も影響を受けるものは何か。",choices:["A. 外れ値","B. 順位","C. 人数","D. 性別"],answer:0,explain:"外れ値（極端に大きいor小さい値）があると平均が大きくずれます。この場合は中央値の方が代表値として適切です。",type:"preset"},
  {q:"標準偏差が大きいとはどういう意味か。",choices:["A. データがまとまっている","B. データがばらついている","C. 人数が多い","D. 平均が高い"],answer:1,explain:"標準偏差はデータの散らばりを示します。大きいほど個人差が大きく、小さいほどみんな似ています。",type:"preset"},
  {q:"相関係数が0.90だった。正しい説明はどれか。",choices:["A. 強い正の相関","B. 強い負の相関","C. 因果関係がある","D. 相関なし"],answer:0,explain:"相関係数は−1〜+1の値を取ります。+0.8以上は強い正の相関、−0.8以下は強い負の相関です。0に近いほど相関なしです。",type:"preset"},
  {q:"相関関係があると必ず因果関係があるか。",choices:["A. ある","B. ない","C. 場合による","D. 統計次第"],answer:1,explain:"相関≠因果。例：アイスが売れると熱中症が増えるが、原因は共通の「夏」です。相関があっても因果とは言えません。",type:"preset"},
  {q:"母集団とは何か。",choices:["A. 実験参加者","B. 全体集団","C. 平均値","D. 標本平均"],answer:1,explain:"母集団は「日本人全員」など全体のことです。その一部を取り出したものが標本です。",type:"preset"},
  {q:"標本を調べる目的は何か。",choices:["A. 標本だけ知りたい","B. 母集団を推測したい","C. 数字を書くため","D. 実験を長くするため"],answer:1,explain:"標本から母集団を推測することが推測統計の目的です。100人のデータから日本人全体を推測するイメージです。",type:"preset"},
  {q:"95％信頼区間とは何か。",choices:["A. 95％の人が入る区間","B. 母平均がありそうな範囲","C. 得点の平均","D. 偶然の確率"],answer:1,explain:"同じ方法で標本抽出を繰り返したとき、95％の確率で母平均を含む区間が得られるという考え方です。「母平均がありそうな範囲の推定」と覚えておきましょう。",type:"preset"},
  {q:"帰無仮説とは何か。",choices:["A. 効果がある","B. 差がある","C. 差がない","D. 平均が高い"],answer:2,explain:"帰無仮説は「差がない・効果がない」という仮説です。これを統計的に棄却できたとき、有意差ありと判断します。",type:"preset"},
  {q:"p値が0.03だった。正しい説明はどれか。",choices:["A. 有意差なし","B. 有意差あり","C. 相関なし","D. 平均が同じ"],answer:1,explain:"有意水準α=0.05のとき、p<0.05で有意差ありと判断します。p=0.03は0.05より小さいので有意差ありです。",type:"preset"},
  {q:"3群以上の平均を比較するとき使う分析は何か。",choices:["A. t検定","B. 相関分析","C. 分散分析（ANOVA）","D. 回帰分析"],answer:2,explain:"2群の比較にはt検定、3群以上の比較には分散分析（ANOVA）を使います。これは頻出問題です。",type:"preset"},
  {q:"球面性違反が起こると増える誤りはどれか。",choices:["A. 第1種の誤り","B. 第2種の誤り","C. 相関係数","D. 自由度"],answer:0,explain:"球面性違反ではF値が適切に評価されず、本当は差がないのに「差がある」と判断してしまう第1種の誤り（偽陽性）が増えます。Greenhouse–Geisser補正が用いられます。",type:"preset"},
  {q:"間隔尺度の特徴として正しいのはどれか。",choices:["A. 絶対的なゼロ点がある","B. 順番のみわかる","C. 差が等しい","D. 分類のみ可能"],answer:2,explain:"間隔尺度は数値の差が等しいですが、絶対的なゼロ点がありません。例：温度（0度は「温度がない」ではない）、西暦年。",type:"preset"},
  {q:"比率尺度の例として正しいのはどれか。",choices:["A. 気温","B. 知能指数（IQ）","C. 体重","D. 順位"],answer:2,explain:"比率尺度は絶対的なゼロ点があります。体重0kgは本当に「重さなし」です。身長・反応時間・頻度なども比率尺度です。",type:"preset"},
  {q:"最頻値（モード）とは何か。",choices:["A. データの真ん中の値","B. 最も頻繁に現れる値","C. 全データの合計","D. 標準偏差"],answer:1,explain:"最頻値は最も頻繁に現れる値です。名義尺度データにも使えるのが特徴で、平均・中央値は使えません。",type:"preset"},
  {q:"正規分布の特徴として正しいのはどれか。",choices:["A. 左右非対称","B. 平均・中央値・最頻値が一致する","C. 外れ値が多い","D. 二峰性"],answer:1,explain:"正規分布は左右対称の釣り鐘型で、平均・中央値・最頻値がすべて一致します。多くの心理学的測定値はほぼ正規分布に従います。",type:"preset"},
  {q:"標準化（z得点）の目的は何か。",choices:["A. データを大きくする","B. 異なるスケールのデータを比較可能にする","C. 相関を高める","D. 外れ値を除去する"],answer:1,explain:"z得点は平均0・標準偏差1に変換します。これにより身長と体重など異なる単位のデータを比較できます。",type:"preset"},
  {q:"第1種の誤り（α誤り）とは何か。",choices:["A. 本当に差があるのに差なしと判断","B. 本当は差がないのに差ありと判断","C. 標本が小さすぎる","D. 相関が高すぎる"],answer:1,explain:"第1種の誤りは「偽陽性」です。本当は差がないのに「差がある」と誤って判断することです。有意水準αはこの誤りの確率を設定します。",type:"preset"},
  {q:"第2種の誤り（β誤り）とは何か。",choices:["A. 本当は差がないのに差ありと判断","B. 本当に差があるのに差なしと判断","C. 標本が大きすぎる","D. p値が低すぎる"],answer:1,explain:"第2種の誤りは「偽陰性」です。本当は差があるのに「差なし」と判断してしまうことです。サンプルサイズが小さいと起こりやすい。",type:"preset"},
  {q:"検定力（統計的検出力）とは何か。",choices:["A. p値の逆数","B. 差がないときに差なしと判断する確率","C. 本当に差があるとき正しく差ありと判断できる確率","D. 標準偏差の二乗"],answer:2,explain:"検定力は1−βです。本当に効果があるとき、それを正しく検出できる確率です。サンプルサイズが大きいほど検定力は高くなります。",type:"preset"},
  {q:"サンプルサイズ（n）が大きくなるとどうなるか。",choices:["A. p値が必ず大きくなる","B. 小さな差でも有意になりやすい","C. 標準偏差が大きくなる","D. 相関係数がゼロになる"],answer:1,explain:"nが大きいほど標準誤差が小さくなり、小さな差でも統計的に有意になります。大規模研究では臨床的意義がない差でも有意になることがあります。",type:"preset"},
  {q:"効果量（effect size）とは何か。",choices:["A. p値と同じ","B. 差の実際の大きさを示す指標","C. 標本数","D. 信頼区間の幅"],answer:1,explain:"効果量はCohenのdなどで表され、差の実際の大きさを示します。p値は有意かどうかだけ、効果量は「どのくらい大きな差か」を示します。",type:"preset"},
  {q:"Cohenのdで効果量「大」はどれか。",choices:["A. d = 0.1","B. d = 0.3","C. d = 0.5","D. d = 0.8以上"],answer:3,explain:"Cohenの基準：d=0.2が小、d=0.5が中、d=0.8以上が大です。ABAの介入研究では効果量が大きいことが多いです。",type:"preset"},
  {q:"独立変数と従属変数の関係として正しいのはどれか。",choices:["A. 独立変数が従属変数の影響を受ける","B. 独立変数が従属変数に影響を与える","C. 両者は常に相関する","D. 従属変数は操作できる"],answer:1,explain:"独立変数（操作する変数）が従属変数（測定する変数）に影響を与えます。ABAでは介入が独立変数、問題行動の頻度が従属変数です。",type:"preset"},
  {q:"対応のあるt検定を使うのはどれか。",choices:["A. 男女2グループの平均比較","B. 介入前後の同一人物の比較","C. 3グループの比較","D. 名義データの比較"],answer:1,explain:"対応のあるt検定は同一人物の前後比較（反復測定）に使います。男女など別グループの比較は対応のないt検定です。",type:"preset"},
  {q:"分散（variance）とは何か。",choices:["A. 標準偏差の二乗","B. 平均の二乗","C. 中央値の差","D. 相関係数"],answer:0,explain:"分散は標準偏差の二乗です。逆に言えば標準偏差は分散の平方根です。分散分析（ANOVA）の名前はこの「分散」からきています。",type:"preset"},
  {q:"χ²検定（カイ二乗検定）はどんなデータに使うか。",choices:["A. 連続データ","B. 名義・カテゴリデータ","C. 順序データ","D. 比率データ"],answer:1,explain:"χ²検定は度数・カテゴリデータに使います。例：男女と好きなスポーツの関連を調べるときなど。",type:"preset"},
  {q:"ノンパラメトリック検定はどんなときに使うか。",choices:["A. 正規分布が仮定できる","B. サンプルが大きい","C. 正規分布が仮定できない","D. 変数が比率尺度"],answer:2,explain:"データが正規分布に従わない場合、またはサンプルサイズが小さい場合にノンパラメトリック検定（Mann-WhitneyのU検定など）を使います。",type:"preset"},
  {q:"単回帰分析の目的はどれか。",choices:["A. 2変数の差を検定する","B. 1つの変数から別の変数を予測する","C. 3群の平均を比較する","D. カテゴリを分類する"],answer:1,explain:"単回帰分析は1つの独立変数から従属変数を予測します。例：学習時間（独立変数）からテスト点数（従属変数）を予測。",type:"preset"},
  {q:"重回帰分析と単回帰分析の違いは何か。",choices:["A. 重回帰は従属変数が複数","B. 重回帰は独立変数が複数","C. 重回帰はノンパラメトリック","D. 重回帰はカテゴリデータ用"],answer:1,explain:"重回帰分析は複数の独立変数（予測変数）から従属変数を予測します。単回帰は独立変数が1つ、重回帰は2つ以上です。",type:"preset"},
  {q:"多重比較問題とは何か。",choices:["A. 変数が多すぎる問題","B. 繰り返し検定することで第1種誤りが増える問題","C. サンプルが少なすぎる問題","D. 正規分布からのずれ"],answer:1,explain:"複数回の検定を繰り返すと、偶然有意になる確率（第1種誤り）が蓄積されます。これを防ぐためBonferroni法などの補正を行います。",type:"preset"},
  {q:"Bonferroni補正とは何か。",choices:["A. サンプルサイズを増やす方法","B. 有意水準を検定回数で割って厳しくする方法","C. 正規分布を仮定する方法","D. 相関係数を補正する方法"],answer:1,explain:"Bonferroni補正はα（有意水準）を検定回数で割ります。例：3回検定するなら0.05÷3≈0.017が新たな有意水準になります。",type:"preset"},
  {q:"要因計画とは何か。",choices:["A. 1つの独立変数を操作する実験","B. 複数の独立変数を組み合わせた実験計画","C. 参加者を無作為に配置する方法","D. 標本を選ぶ方法"],answer:1,explain:"要因計画は2つ以上の独立変数（要因）を組み合わせた実験計画です。交互作用効果（要因の組み合わせによる効果）を調べられます。",type:"preset"},
  {q:"交互作用とは何か。",choices:["A. 2変数の相関","B. ある要因の効果が別の要因の水準によって異なること","C. 主効果の合計","D. 平均の差"],answer:1,explain:"交互作用は「AとBの組み合わせによって効果が変わる」現象です。例：ある薬は男性には効くが女性には効かない場合などです。",type:"preset"},
  {q:"内的妥当性とは何か。",choices:["A. 結果を外部に一般化できるか","B. 測定が正確か","C. 変数間の因果関係が正しく推論できるか","D. 倫理的に適切か"],answer:2,explain:"内的妥当性は「観察された効果が本当に独立変数のせいか」という問いです。交絡変数の統制により高まります。",type:"preset"},
  {q:"外的妥当性とは何か。",choices:["A. 測定ツールの精度","B. 結果を他の状況・集団に一般化できるか","C. 因果推論の正確さ","D. 倫理審査の通過"],answer:1,explain:"外的妥当性は研究結果の一般化可能性です。大学生だけの実験結果を全人類に一般化できるか？という問いが典型例です。",type:"preset"},
  {q:"信頼性（reliability）とは何か。",choices:["A. 測りたいものを測れているか","B. 繰り返し測定したとき同じ結果が得られるか","C. 倫理的に適切か","D. 統計的に有意か"],answer:1,explain:"信頼性は測定の一貫性・安定性です。何度測っても同じ結果が出ることを指します。「再現性」と覚えておきましょう。",type:"preset"},
  {q:"妥当性（validity）とは何か。",choices:["A. 繰り返し同じ結果が出るか","B. 測りたいものを正しく測れているか","C. サンプルサイズが十分か","D. 正規分布に従うか"],answer:1,explain:"妥当性は「本当に測りたいものを測れているか」です。身長計で体重を測っても信頼性はあっても妥当性はありません。",type:"preset"},
  {q:"ランダム割り付け（無作為化）の目的は何か。",choices:["A. サンプルを増やす","B. 交絡変数を群間で均等にする","C. 測定誤差をなくす","D. 正規分布を確保する"],answer:1,explain:"ランダム割り付けにより、交絡変数（年齢・性別・重症度など）が各群でほぼ同等になります。これにより因果推論の妥当性が高まります。",type:"preset"},
  {q:"プラセボ効果とは何か。",choices:["A. 薬の副作用","B. 本物の治療がないのに効果があると感じる現象","C. ランダム誤差","D. 第2種の誤り"],answer:1,explain:"プラセボ効果は「治療を受けた」という信念だけで症状が改善する現象です。これを統制するため二重盲検法が用いられます。",type:"preset"},
  {q:"二重盲検法（double-blind）とは何か。",choices:["A. 参加者のみが条件を知らない","B. 参加者と実験者の両方が条件を知らない","C. 実験者のみが条件を知らない","D. 統計家が条件を知らない"],answer:1,explain:"二重盲検法は参加者も実験者も「本物か偽物か」を知らない状態で実施します。バイアスを最小化できます。",type:"preset"},
  {q:"測定の4尺度水準を情報量が少ない順に正しく並べたのはどれか。",choices:["A. 名義→比率→順序→間隔","B. 名義→順序→間隔→比率","C. 順序→名義→比率→間隔","D. 間隔→名義→順序→比率"],answer:1,explain:"正しい順番は「名義→順序→間隔→比率」です。比率尺度が最も情報量が多い（絶対ゼロ点あり）。",type:"preset"},
  {q:"散布図（scatterplot）は何を確認するために使うか。",choices:["A. 平均の差","B. 2変数の関係（相関）","C. 度数分布","D. 信頼区間"],answer:1,explain:"散布図は2変数の関係を視覚的に確認するために使います。相関分析の前に散布図を見て、外れ値や非線形関係を確認することが重要です。",type:"preset"},
  {q:"ヒストグラムは何を表すか。",choices:["A. 2変数の関係","B. データの度数分布","C. 時系列変化","D. 平均値の比較"],answer:1,explain:"ヒストグラムは1つの変数の分布（どの値がどのくらいの頻度で現れるか）を表します。正規分布かどうかを視覚的に確認できます。",type:"preset"},
  {q:"標準誤差（SE）とは何か。",choices:["A. 個々のデータのばらつき","B. 標本平均のばらつき","C. 最大値と最小値の差","D. 第1種誤りの確率"],answer:1,explain:"標準誤差は「標本平均がどのくらいばらつくか」を示します。サンプルサイズが大きいほど小さくなります。SE=標準偏差÷√nです。",type:"preset"},
  {q:"反復測定ANOVAとはどんな分析か。",choices:["A. 異なる参加者の複数群を比較","B. 同一参加者の複数条件・時点を比較","C. 2変数の相関を検定する","D. カテゴリデータを分析する"],answer:1,explain:"反復測定ANOVAは同一参加者を複数回測定するデザインに使います。介入前・中・後の行動頻度を比較する場合などに使用します。",type:"preset"},
  {q:"メタ分析とは何か。",choices:["A. 1つの大規模実験","B. 複数の研究結果を統合して分析する手法","C. 質問紙法の一種","D. 観察研究の方法"],answer:1,explain:"メタ分析は複数の研究結果を統計的に統合し、より大きな標本での効果量や一貫性を推定します。最も信頼度の高いエビデンスとされます。",type:"preset"},
  {q:"外れ値（outlier）の対処として適切でないのはどれか。",choices:["A. 中央値を使う","B. 外れ値を確認して原因を調べる","C. データ変換（対数変換など）","D. 何も確認せず削除する"],answer:3,explain:"外れ値を何も確認せず削除することは不適切です。まず原因を確認し（入力ミスか？本物のデータか？）、理由を記録した上で判断します。",type:"preset"},
  {q:"記述統計と推測統計の違いは何か。",choices:["A. 記述統計は予測、推測統計は要約","B. 記述統計はデータ要約、推測統計は母集団への推論","C. 記述統計は大規模、推測統計は小規模","D. 記述統計は計算不要"],answer:1,explain:"記述統計は手元のデータを要約します（平均・SD等）。推測統計は標本から母集団を推測・検定します。まず記述統計で概要を把握するのが基本手順です。",type:"preset"},
  {q:"ABA研究でシングルケースデザインをよく使う理由はどれか。",choices:["A. 実施が簡単だから","B. 少人数でも個人への介入効果を厳密に評価できるから","C. 統計が不要だから","D. グループ比較に向いているから"],answer:1,explain:"シングルケースデザイン（ABAB法等）は個人内比較で介入効果を検証します。ABAでは1人ひとりへの効果を厳密に評価するため広く用いられます。",type:"preset"}
];

// ============================================================
// STATE
// ============================================================
let allQuestions = [...presetQuestions];
let quizQueue = [];
let current = 0;
let score = 0;
let answered = false;
let selectedCount = 3;
let aiQuestions = []; // for display in AI tab

// ============================================================
// TAB
// ============================================================
function switchTab(tab) {
  document.getElementById('tabQuiz').style.display = tab === 'quiz' ? 'block' : 'none';
  document.getElementById('tabAi').style.display = tab === 'ai' ? 'block' : 'none';
  document.getElementById('tab-quiz').classList.toggle('active', tab === 'quiz');
  document.getElementById('tab-ai').classList.toggle('active', tab === 'ai');
}

// ============================================================
// QUIZ LOGIC
// ============================================================
function startQuiz() {
  quizQueue = [...allQuestions];
  // shuffle
  for (let i = quizQueue.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [quizQueue[i], quizQueue[j]] = [quizQueue[j], quizQueue[i]];
  }
  current = 0;
  score = 0;
  document.getElementById('startScreen').style.display = 'none';
  document.getElementById('quizArea').style.display = 'block';
  showQuestion();
}

function showQuestion() {
  answered = false;
  const q = quizQueue[current];
  const total = quizQueue.length;
  const badge = q.type === 'ai'
    ? '<span class="q-badge badge-ai">🤖 AI生成</span>'
    : '<span class="q-badge badge-preset">📚 プリセット</span>';
  document.getElementById('qNumber').innerHTML = `問題 ${current + 1} / ${total}${badge}`;
  document.getElementById('qText').textContent = q.q;
  document.getElementById('explainBox').classList.remove('show');
  document.getElementById('nextBtn').classList.remove('show');

  const choicesEl = document.getElementById('choices');
  choicesEl.innerHTML = '';
  q.choices.forEach((c, i) => {
    const btn = document.createElement('button');
    btn.className = 'choice-btn';
    btn.textContent = c;
    btn.onclick = () => selectAnswer(i);
    choicesEl.appendChild(btn);
  });
  updateProgress();
}

function selectAnswer(index) {
  if (answered) return;
  answered = true;
  const q = quizQueue[current];
  const btns = document.querySelectorAll('.choice-btn');
  btns.forEach((btn, i) => {
    btn.disabled = true;
    if (i === q.answer) btn.classList.add(index === q.answer ? 'correct' : 'reveal-correct');
    if (i === index && index !== q.answer) btn.classList.add('wrong');
  });
  if (index === q.answer) score++;
  document.getElementById('explainText').textContent = q.explain;
  document.getElementById('explainBox').classList.add('show');
  document.getElementById('nextBtn').classList.add('show');
  document.getElementById('nextBtn').textContent =
    current < quizQueue.length - 1 ? '次の問題 →' : '結果を見る →';
  updateProgress();
}

function nextQuestion() {
  current++;
  if (current >= quizQueue.length) { showResult(); return; }
  showQuestion();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function updateProgress() {
  const total = quizQueue.length || allQuestions.length;
  const done = quizQueue.length ? current : 0;
  const pct = total ? (done / total) * 100 : 0;
  document.getElementById('progressBar').style.width = pct + '%';
  document.getElementById('progressText').textContent = `${done} / ${total} 問`;
  document.getElementById('headerScore').textContent = `${score} / ${done}`;
}

function showResult() {
  document.getElementById('quizArea').style.display = 'none';
  document.getElementById('resultScreen').classList.add('show');
  const total = quizQueue.length;
  const pct = Math.round((score / total) * 100);
  document.getElementById('resultScore').textContent = score;
  document.getElementById('resultTotal').textContent = `/ ${total} 問正解`;
  document.getElementById('progressBar').style.width = '100%';
  document.getElementById('progressText').textContent = `${total} / ${total} 問`;
  document.getElementById('headerScore').textContent = `${score} / ${total}`;
  setTimeout(() => { document.getElementById('scoreBarFill').style.width = pct + '%'; }, 100);
  let msg, sub;
  if (pct >= 90) { msg = "素晴らしい！合格圏内です 🏆"; sub = "この調子で本番も自信を持って臨みましょう。"; }
  else if (pct >= 70) { msg = "よくできました！あと一歩 💪"; sub = "間違えた問題の解説を読み返しておきましょう。"; }
  else if (pct >= 50) { msg = "もう少し復習が必要です 📖"; sub = "検定・誤り・効果量あたりを重点的に復習しましょう。"; }
  else { msg = "基礎からしっかり固めましょう 🌱"; sub = "尺度・平均・標準偏差・相関の基本概念から整理しましょう。"; }
  document.getElementById('resultMsg').textContent = msg;
  document.getElementById('resultSub').textContent = sub;
}

function restartQuiz() {
  document.getElementById('resultScreen').classList.remove('show');
  document.getElementById('scoreBarFill').style.width = '0%';
  document.getElementById('startScreen').style.display = 'block';
  const total = allQuestions.length;
  document.getElementById('startDesc').innerHTML =
    `全${total}問（プリセット50問＋AI生成${total - 50}問）・4択形式<br>選択肢をタップすると正誤がわかります`;
  score = 0;
  updateProgress();
}

// ============================================================
// AI GENERATION
// ============================================================
function selectCount(el, n) {
  selectedCount = n;
  document.querySelectorAll('.count-chip').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
}

function setTopic(topic) {
  document.getElementById('topicInput').value = topic;
  switchTab('ai');
  document.getElementById('topicInput').focus();
}

async function generateQuestions() {
  const topic = document.getElementById('topicInput').value.trim();
  if (!topic) {
    document.getElementById('topicInput').focus();
    return;
  }
  const btn = document.getElementById('generateBtn');
  const errEl = document.getElementById('errorMsg');
  const loadEl = document.getElementById('loadingMsg');

  btn.disabled = true;
  btn.textContent = '生成中...';
  errEl.classList.remove('show');
  loadEl.classList.add('show');

  const prompt = `あなたは心理学統計法の試験問題作成の専門家です。
以下のテーマについて、大学試験レベルの4択問題を${selectedCount}問作成してください。

テーマ：${topic}

【出力形式】
必ずJSONのみ出力。説明文・前置き・コードブロック記号は一切不要。
次の形式の配列を返してください：

[
  {
    "q": "問題文（日本語・簡潔に）",
    "choices": ["A. 選択肢1", "B. 選択肢2", "C. 選択肢3", "D. 選択肢4"],
    "answer": 正解のインデックス（0〜3の整数）,
    "explain": "解説文（2〜3文、具体例を含む）"
  }
]

【条件】
- 問題はすべて心理学統計法に関連させること
- 4択すべてに「A. 」「B. 」「C. 」「D. 」を先頭につける
- 正解は毎回異なる選択肢に分散させる
- 解説は平易な日本語で`;

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-6',
        max_tokens: 1000,
        messages: [{ role: 'user', content: prompt }]
      })
    });
    const data = await res.json();
    const text = data.content?.[0]?.text || '';
    const clean = text.replace(/```json|```/g, '').trim();
    const parsed = JSON.parse(clean);

    parsed.forEach(item => {
      const q = { ...item, type: 'ai' };
      allQuestions.push(q);
      aiQuestions.push(q);
    });

    loadEl.classList.remove('show');
    btn.disabled = false;
    btn.textContent = '✨ 問題を生成する';
    document.getElementById('topicInput').value = '';
    renderAIQueue();
    updateStartScreen();

  } catch (e) {
    loadEl.classList.remove('show');
    btn.disabled = false;
    btn.textContent = '✨ 問題を生成する';
    errEl.classList.add('show');
  }
}

function renderAIQueue() {
  const area = document.getElementById('aiQueueArea');
  const list = document.getElementById('aiQueueList');
  const countEl = document.getElementById('aiQueueCount');
  if (aiQuestions.length === 0) { area.style.display = 'none'; return; }
  area.style.display = 'block';
  countEl.textContent = `（${aiQuestions.length}問）`;
  list.innerHTML = '';
  aiQuestions.forEach((q, i) => {
    const div = document.createElement('div');
    div.className = 'ai-queue-item';
    div.innerHTML = `
      <span style="flex:1;font-size:13px;line-height:1.4">${q.q.length > 30 ? q.q.slice(0, 30) + '…' : q.q}</span>
      <button class="ai-queue-delete" onclick="deleteAIQuestion(${i})" title="削除">✕</button>
    `;
    list.appendChild(div);
  });
}

function deleteAIQuestion(i) {
  const removed = aiQuestions[i];
  aiQuestions.splice(i, 1);
  const idx = allQuestions.indexOf(removed);
  if (idx !== -1) allQuestions.splice(idx, 1);
  renderAIQueue();
  updateStartScreen();
}

function updateStartScreen() {
  const total = allQuestions.length;
  const aiCount = aiQuestions.length;
  document.getElementById('startDesc').innerHTML =
    `全${total}問（プリセット50問＋AI生成${aiCount}問）・4択形式<br>選択肢をタップすると正誤がわかります<br><span style="color:#E8A164;font-size:12px">✨ クイズタブからスタートすると新しい問題も出題されます</span>`;
}

// init
updateProgress();
</script>
</body>
</html>