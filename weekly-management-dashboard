<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>療育経営ダッシュボード</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f2efe6; --panel:#ece7d9; --ink:#2a2b24; --ink-soft:#5c5c50;
    --moss:#3f5443; --moss-deep:#2c3c30; --clay:#97633f; --line:#d7d0bd; --paper:#faf8f1;
    --up:#3f5443; --down:#97633f;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'Noto Sans JP',sans-serif;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:920px;margin:0 auto;padding:40px 24px 100px;}
  header{margin-bottom:34px;padding-bottom:22px;border-bottom:1px solid var(--line);}
  .eyebrow{font-family:'EB Garamond',serif;font-style:italic;font-size:13px;color:var(--clay);letter-spacing:.06em;margin:0 0 6px;}
  h1{font-family:'Noto Serif JP',serif;font-size:26px;font-weight:700;color:var(--moss-deep);margin:0 0 8px;}
  header p{font-size:13px;color:var(--ink-soft);line-height:1.7;margin:0;max-width:600px;}

  .card{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:22px 24px;margin-bottom:20px;}
  .card h2{font-family:'Noto Serif JP',serif;font-size:16px;font-weight:600;color:var(--moss-deep);margin:0 0 4px;}
  .card .sub{font-size:12px;color:var(--ink-soft);margin:0 0 16px;line-height:1.6;}

  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  @media(max-width:700px){.grid{grid-template-columns:repeat(2,1fr);}}
  .stat{background:var(--panel);border-radius:5px;padding:16px;border-left:3px solid var(--moss);}
  .stat .label{font-family:'EB Garamond',serif;font-size:11px;letter-spacing:.06em;color:var(--ink-soft);text-transform:uppercase;margin-bottom:6px;}
  .stat .value{font-family:'Noto Serif JP',serif;font-size:22px;font-weight:700;color:var(--moss-deep);line-height:1.3;}
  .stat .diff{font-size:11px;margin-top:4px;color:var(--ink-soft);}
  .stat .diff.pos{color:var(--up);} .stat .diff.neg{color:var(--down);}

  .form-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;align-items:end;}
  @media(max-width:700px){.form-grid{grid-template-columns:repeat(2,1fr);}}
  label{display:block;font-size:11.5px;color:var(--ink-soft);margin-bottom:5px;}
  input[type=number],input[type=date]{
    width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:4px;
    background:#fff;font-size:14px;font-family:'Noto Sans JP',sans-serif;color:var(--ink);
  }
  input:focus{outline:none;border-color:var(--moss);}
  .btn{
    background:var(--moss);color:#fff;border:none;border-radius:4px;padding:10px 18px;
    font-size:13px;cursor:pointer;font-family:'Noto Sans JP',sans-serif;transition:background .15s;
  }
  .btn:hover{background:var(--moss-deep);}
  .btn.ghost{background:none;border:1px solid var(--line);color:var(--ink-soft);}
  .btn.ghost:hover{border-color:var(--clay);color:var(--clay);}
  .btn.small{padding:5px 10px;font-size:12px;}
  .row{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}

  table{width:100%;border-collapse:collapse;font-size:13px;}
  th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);}
  th{font-family:'EB Garamond',serif;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);font-weight:400;}
  td.num{text-align:right;font-family:'EB Garamond',serif;font-size:14px;}
  tr:hover td{background:rgba(63,84,67,0.04);}
  .del-btn{background:none;border:none;color:var(--clay);cursor:pointer;font-size:12px;text-decoration:underline;}

  .bars{display:flex;align-items:flex-end;gap:8px;height:120px;margin-top:8px;padding-top:10px;}
  .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end;}
  .bar{width:100%;background:var(--moss);border-radius:3px 3px 0 0;min-height:2px;}
  .bar-label{font-size:10px;color:var(--ink-soft);font-family:'EB Garamond',serif;}

  .sim-row{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);}
  .sim-row:last-child{border-bottom:none;}
  .sim-row input[type=range]{width:100%;accent-color:var(--moss);}
  .sim-result{font-family:'Noto Serif JP',serif;font-weight:700;color:var(--moss-deep);font-size:16px;text-align:right;min-width:150px;}
  .sim-title{font-size:13px;color:var(--ink);margin-bottom:6px;}

  .empty{color:var(--ink-soft);font-size:13px;padding:20px 0;text-align:center;}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--moss-deep);color:#fff;
    padding:10px 20px;border-radius:5px;font-size:13px;opacity:0;transition:opacity .3s;pointer-events:none;}
  .toast.show{opacity:1;}
  details summary{cursor:pointer;font-size:13px;color:var(--moss);margin-bottom:10px;}
</style>
</head>
<body>
<div class="wrap">
  <header>
