<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>療育経営ダッシュボード</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#f2efe6; --panel:#ece7d9; --ink:#2a2b24; --ink-soft:#5c5c50;
    --moss:#3f5443; --moss-deep:#2c3c30; --clay:#97633f; --line:#d7d0bd; --paper:#faf8f1;
    --up:#3f5443; --down:#97633f;
  }
  *{box-sizing:border-box;}
  body{margin:0;background:var(--bg);color:var(--ink);font-family:'Noto Sans JP',sans-serif;-webkit-font-smoothing:antialiased;}
  .wrap{max-width:920px;margin:0 auto;padding:40px 24px 100px;}
  header{margin-bottom:34px;padding-bottom:22px;border-bottom:1px solid var(--line);}
  .eyebrow{font-family:'EB Garamond',serif;font-style:italic;font-size:13px;color:var(--clay);letter-spacing:.06em;margin:0 0 6px;}
  h1{font-family:'Noto Serif JP',serif;font-size:26px;font-weight:700;color:var(--moss-deep);margin:0 0 8px;}
  header p{font-size:13px;color:var(--ink-soft);line-height:1.7;margin:0;max-width:600px;}

  .card{background:var(--paper);border:1px solid var(--line);border-radius:6px;padding:22px 24px;margin-bottom:20px;}
  .card h2{font-family:'Noto Serif JP',serif;font-size:16px;font-weight:600;color:var(--moss-deep);margin:0 0 4px;}
  .card .sub{font-size:12px;color:var(--ink-soft);margin:0 0 16px;line-height:1.6;}

  .grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;}
  @media(max-width:700px){.grid{grid-template-columns:repeat(2,1fr);}}
  .stat{background:var(--panel);border-radius:5px;padding:16px;border-left:3px solid var(--moss);}
  .stat .label{font-family:'EB Garamond',serif;font-size:11px;letter-spacing:.06em;color:var(--ink-soft);text-transform:uppercase;margin-bottom:6px;}
  .stat .value{font-family:'Noto Serif JP',serif;font-size:22px;font-weight:700;color:var(--moss-deep);line-height:1.3;}
  .stat .diff{font-size:11px;margin-top:4px;color:var(--ink-soft);}
  .stat .diff.pos{color:var(--up);} .stat .diff.neg{color:var(--down);}

  .form-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;align-items:end;}
  @media(max-width:700px){.form-grid{grid-template-columns:repeat(2,1fr);}}
  label{display:block;font-size:11.5px;color:var(--ink-soft);margin-bottom:5px;}
  input[type=number],input[type=date]{
    width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:4px;
    background:#fff;font-size:14px;font-family:'Noto Sans JP',sans-serif;color:var(--ink);
  }
  input:focus{outline:none;border-color:var(--moss);}
  .btn{
    background:var(--moss);color:#fff;border:none;border-radius:4px;padding:10px 18px;
    font-size:13px;cursor:pointer;font-family:'Noto Sans JP',sans-serif;transition:background .15s;
  }
  .btn:hover{background:var(--moss-deep);}
  .btn.ghost{background:none;border:1px solid var(--line);color:var(--ink-soft);}
  .btn.ghost:hover{border-color:var(--clay);color:var(--clay);}
  .btn.small{padding:5px 10px;font-size:12px;}
  .row{display:flex;gap:10px;margin-top:14px;flex-wrap:wrap;}

  table{width:100%;border-collapse:collapse;font-size:13px;}
  th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);}
  th{font-family:'EB Garamond',serif;font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);font-weight:400;}
  td.num{text-align:right;font-family:'EB Garamond',serif;font-size:14px;}
  tr:hover td{background:rgba(63,84,67,0.04);}
  .del-btn{background:none;border:none;color:var(--clay);cursor:pointer;font-size:12px;text-decoration:underline;}

  .bars{display:flex;align-items:flex-end;gap:8px;height:120px;margin-top:8px;padding-top:10px;}
  .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px;height:100%;justify-content:flex-end;}
  .bar{width:100%;background:var(--moss);border-radius:3px 3px 0 0;min-height:2px;}
  .bar-label{font-size:10px;color:var(--ink-soft);font-family:'EB Garamond',serif;}

  .sim-row{display:grid;grid-template-columns:1fr auto;gap:16px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line);}
  .sim-row:last-child{border-bottom:none;}
  .sim-row input[type=range]{width:100%;accent-color:var(--moss);}
  .sim-result{font-family:'Noto Serif JP',serif;font-weight:700;color:var(--moss-deep);font-size:16px;text-align:right;min-width:150px;}
  .sim-title{font-size:13px;color:var(--ink);margin-bottom:6px;}

  .empty{color:var(--ink-soft);font-size:13px;padding:20px 0;text-align:center;}
  .toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--moss-deep);color:#fff;
    padding:10px 20px;border-radius:5px;font-size:13px;opacity:0;transition:opacity .3s;pointer-events:none;}
  .toast.show{opacity:1;}
  details summary{cursor:pointer;font-size:13px;color:var(--moss);margin-bottom:10px;}
</style>
</head>
<body>
<div class="wrap">
  <header>
    <p class="eyebrow">Weekly management dashboard</p>
    <h1>療育経営ダッシュボード</h1>
    <p>毎週の実績を入力するだけで、推定売上・利用率・目標との差を自動計算。数字で経営を考える練習用ツール。</p>
  </header>

  <div class="card">
    <details id="settingsDetails">
      <summary>単価・目標の設定（初回に入力）</summary>
      <div class="form-grid" style="margin-top:6px;">
        <div><label>基本単価（円/回）</label><input type="number" id="setUnit" placeholder="例: 6000"></div>
        <div><label>平均加算単価（円/回）</label><input type="number" id="setAddon" placeholder="例: 1500"></div>
        <div><label>週の開所日数</label><input type="number" id="setDays" placeholder="例: 5"></div>
        <div><label>目標月間売上（円）</label><input type="number" id="setTarget" placeholder="例: 3000000"></div>
      </div>
      <div class="row"><button class="btn" id="saveSettings">設定を保存</button></div>
    </details>
  </div>

  <div class="card">
    <h2>今週の実績を入力</h2>
    <p class="sub">延べ利用回数＝この週にあった利用（出席）の合計回数。</p>
    <div class="form-grid">
      <div><label>週の開始日</label><input type="date" id="inWeek"></div>
      <div><label>契約人数</label><input type="number" id="inContracts"></div>
      <div><label>実利用人数</label><input type="number" id="inUsers"></div>
      <div><label>延べ利用回数</label><input type="number" id="inVisits"></div>
    </div>
    <div class="row">
      <button class="btn" id="addEntry">この週を記録する</button>
      <span id="formMsg" style="font-size:12px;color:var(--ink-soft);align-self:center;"></span>
    </div>
  </div>

  <div class="card">
    <h2>今週のダッシュボード</h2>
    <p class="sub" id="latestWeekLabel"></p>
    <div class="grid">
      <div class="stat"><div class="label">今週推定売上</div><div class="value" id="statWeekSales">—</div></div>
      <div class="stat"><div class="label">今月推定売上</div><div class="value" id="statMonthSales">—</div><div class="diff" id="statMonthDiff"></div></div>
      <div class="stat"><div class="label">今週の利用率</div><div class="value" id="statUtil">—</div></div>
      <div class="stat"><div class="label">目標との差</div><div class="value" id="statGap">—</div></div>
    </div>
  </div>

  <div class="card">
    <h2>利用率の推移</h2>
    <p class="sub">直近8週分</p>
    <div class="bars" id="barsUtil"></div>
  </div>

  <div class="card">
    <h2>もし、を試算する</h2>
    <p class="sub">最新週の実績をもとに、月間売上への影響をシミュレーション</p>

    <div class="sim-row">
      <div>
        <div class="sim-title">利用率が <span id="simUtilLabel">+0</span>% 上がると</div>
        <input type="range" id="simUtil" min="-20" max="20" value="0" step="1">
      </div>
      <div class="sim-result" id="simUtilResult">±0円 / 月</div>
    </div>

    <div class="sim-row">
      <div>
        <div class="sim-title">新規契約が <span id="simContractLabel">0</span> 名増えると</div>
        <input type="range" id="simContract" min="0" max="15" value="0" step="1">
      </div>
      <div class="sim-result" id="simContractResult">+0円 / 月</div>
    </div>
  </div>

  <div class="card">
    <h2>週次データ</h2>
    <div id="tableWrap"><div class="empty">まだ記録がありません</div></div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script>
const fmt = n => '¥' + Math.round(n).toLocaleString('ja-JP');
const fmtPct = n => (n>=0?'+':'') + n.toFixed(1) + '%';

let settings = { unit: 6000, addon: 1500, days: 5, target: 3000000 };
let entries = [];

function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 1800);
}

async function loadData(){
  try{
    const s = await window.storage.get('settings');
    if(s && s.value) settings = JSON.parse(s.value);
  }catch(e){}
  try{
    const e = await window.storage.get('entries');
    if(e && e.value) entries = JSON.parse(e.value);
  }catch(e){}
  applySettingsToForm();
  renderAll();
}

function applySettingsToForm(){
  document.getElementById('setUnit').value = settings.unit;
  document.getElementById('setAddon').value = settings.addon;
  document.getElementById('setDays').value = settings.days;
  document.getElementById('setTarget').value = settings.target;
}

async function saveSettings(){
  settings = {
    unit: Number(document.getElementById('setUnit').value) || 0,
    addon: Number(document.getElementById('setAddon').value) || 0,
    days: Number(document.getElementById('setDays').value) || 5,
    target: Number(document.getElementById('setTarget').value) || 0,
  };
  try{
    await window.storage.set('settings', JSON.stringify(settings));
    showToast('設定を保存しました');
    document.getElementById('settingsDetails').removeAttribute('open');
    renderAll();
  }catch(e){ showToast('保存に失敗しました'); }
}

async function addEntry(){
  const week = document.getElementById('inWeek').value;
  const contracts = Number(document.getElementById('inContracts').value);
  const users = Number(document.getElementById('inUsers').value);
  const visits = Number(document.getElementById('inVisits').value);
  const msg = document.getElementById('formMsg');
  if(!week || !contracts || !visits){
    msg.textContent = '週・契約人数・延べ利用回数は必須です';
    return;
  }
  entries = entries.filter(e => e.week !== week);
  entries.push({ week, contracts, users, visits });
  entries.sort((a,b)=> a.week.localeCompare(b.week));
  try{
    await window.storage.set('entries', JSON.stringify(entries));
    msg.textContent = '';
    showToast('記録しました');
    document.getElementById('inContracts').value='';
    document.getElementById('inUsers').value='';
    document.getElementById('inVisits').value='';
    renderAll();
  }catch(e){ msg.textContent = '保存に失敗しました'; }
}

async function deleteEntry(week){
  entries = entries.filter(e => e.week !== week);
  try{
    await window.storage.set('entries', JSON.stringify(entries));
    renderAll();
  }catch(e){ showToast('削除に失敗しました'); }
}

function calcWeekSales(e){
  return e.visits * (settings.unit + settings.addon);
}
function calcUtil(e){
  const capacity = e.contracts * settings.days;
  return capacity > 0 ? (e.visits / capacity) * 100 : 0;
}

function renderAll(){
  renderDashboard();
  renderBars();
  renderSimulator();
  renderTable();
}

function renderDashboard(){
  const latest = entries[entries.length - 1];
  const label = document.getElementById('latestWeekLabel');
  if(!latest){
    label.textContent = 'まだ週次データがありません。上のフォームから入力してください。';
    ['statWeekSales','statMonthSales','statUtil','statGap'].forEach(id=>document.getElementById(id).textContent='—');
    document.getElementById('statMonthDiff').textContent='';
    return;
  }
  label.textContent = `直近入力週: ${latest.week}`;

  const weekSales = calcWeekSales(latest);
  const monthSales = weekSales * 4.33;
  const util = calcUtil(latest);
  const gap = settings.target - monthSales;

  document.getElementById('statWeekSales').textContent = fmt(weekSales);
  document.getElementById('statMonthSales').textContent = fmt(monthSales);
  document.getElementById('statUtil').textContent = util.toFixed(1) + '%';

  const gapEl = document.getElementById('statGap');
  gapEl.textContent = (gap>0 ? '−' : '+') + fmt(Math.abs(gap)).replace('¥','¥');
  gapEl.style.color = gap>0 ? 'var(--down)' : 'var(--up)';

  const diffEl = document.getElementById('statMonthDiff');
  if(settings.target>0){
    const pct = ((monthSales-settings.target)/settings.target*100);
    diffEl.textContent = '目標比 ' + fmtPct(pct);
    diffEl.className = 'diff ' + (pct>=0?'pos':'neg');
  } else { diffEl.textContent=''; }
}

function renderBars(){
  const wrap = document.getElementById('barsUtil');
  wrap.innerHTML = '';
  const last8 = entries.slice(-8);
  if(last8.length===0){ wrap.innerHTML = '<div class="empty">データがありません</div>'; return; }
  const max = Math.max(100, ...last8.map(e=>calcUtil(e)));
  last8.forEach(e=>{
    const util = calcUtil(e);
    const col = document.createElement('div');
    col.className = 'bar-col';
    const h = Math.max(2, (util/max)*100);
    col.innerHTML = `<div style="font-size:10px;color:var(--ink-soft);font-family:'EB Garamond',serif;">${util.toFixed(0)}%</div>
      <div class="bar" style="height:${h}%"></div>
      <div class="bar-label">${e.week.slice(5)}</div>`;
    wrap.appendChild(col);
  });
}

function renderSimulator(){
  const latest = entries[entries.length-1];
  const utilInput = document.getElementById('simUtil');
  const contractInput = document.getElementById('simContract');

  function update(){
    const utilLabel = document.getElementById('simUtilLabel');
    const contractLabel = document.getElementById('simContractLabel');
    const utilResult = document.getElementById('simUtilResult');
    const contractResult = document.getElementById('simContractResult');

    utilLabel.textContent = (utilInput.value>=0?'+':'') + utilInput.value;
    contractLabel.textContent = contractInput.value;

    if(!latest){
      utilResult.textContent = '— (データなし)';
      contractResult.textContent = '— (データなし)';
      return;
    }
    const capacity = latest.contracts * settings.days;
    const extraVisitsPerWeek = capacity * (Number(utilInput.value)/100);
    const extraWeekSales = extraVisitsPerWeek * (settings.unit + settings.addon);
    const extraMonthSales = extraWeekSales * 4.33;
    utilResult.textContent = (extraMonthSales>=0?'+':'') + fmt(extraMonthSales) + ' / 月';

    const visitsPerUser = latest.users>0 ? latest.visits/latest.users : settings.days;
    const newContractMonthSales = Number(contractInput.value) * visitsPerUser * (settings.unit+settings.addon) * 4.33;
    contractResult.textContent = '+' + fmt(newContractMonthSales) + ' / 月';
  }
  utilInput.oninput = update;
  contractInput.oninput = update;
  update();
}

function renderTable(){
  const wrap = document.getElementById('tableWrap');
  if(entries.length===0){ wrap.innerHTML = '<div class="empty">まだ記録がありません</div>'; return; }
  let html = `<table><thead><tr>
    <th>週</th><th style="text-align:right">契約</th><th style="text-align:right">利用者</th>
    <th style="text-align:right">延べ利用</th><th style="text-align:right">利用率</th>
    <th style="text-align:right">週推定売上</th><th></th></tr></thead><tbody>`;
  [...entries].reverse().forEach(e=>{
    html += `<tr>
      <td>${e.week}</td>
      <td class="num">${e.contracts}</td>
      <td class="num">${e.users||'—'}</td>
      <td class="num">${e.visits}</td>
      <td class="num">${calcUtil(e).toFixed(1)}%</td>
      <td class="num">${fmt(calcWeekSales(e))}</td>
      <td><button class="del-btn" onclick="deleteEntry('${e.week}')">削除</button></td>
    </tr>`;
  });
  html += '</tbody></table>';
  wrap.innerHTML = html;
}

document.getElementById('saveSettings').addEventListener('click', saveSettings);
document.getElementById('addEntry').addEventListener('click', addEntry);

loadData();
</script>
</body>
</html>